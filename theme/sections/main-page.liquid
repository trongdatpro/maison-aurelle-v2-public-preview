{% comment %}
  Maison Aurelle V2 — Standard Editorial Page Section
{% endcomment %}

<section class="section-padding" style="background-color: var(--color-canvas); min-height: 70vh;">
  <div class="container-boxed" style="max-width: 800px;">
    <div style="border-bottom: 1px solid var(--color-border); padding-bottom: 1.5rem; margin-bottom: 2.5rem; text-align: center;">
      <h1 class="font-headline-lg" style="margin: 0; color: var(--color-primary);">
        {{ page.title | escape }}
      </h1>
    </div>

    <div class="font-body-md" style="color: var(--color-text-variant); line-height: 1.75;">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}
