{% comment %}
  Maison Aurelle V2 — 404 Not Found Section
{% endcomment %}

<section class="section-padding" style="background-color: var(--color-canvas); min-height: 70vh; display: flex; align-items: center;">
  <div class="container-boxed" style="text-align: center; max-width: 600px; margin: 0 auto;">
    <p class="font-label-caps" style="color: var(--color-secondary); letter-spacing: 0.2em; margin-bottom: 0.5rem;">
      Error 404
    </p>
    <h1 class="font-headline-lg" style="margin: 0 0 1rem 0; color: var(--color-primary);">
      Page Not Found
    </h1>
    <p class="font-body-md" style="color: var(--color-text-variant); margin: 0 0 2rem 0;">
      The architectural piece or curation page you are looking for is unavailable or has moved to an archived salon.
    </p>
    <div>
      <a href="{{ routes.root_url }}" class="btn-primary">
        Return to Home Curation
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404 Not Found",
  "settings": []
}
{% endschema %}
