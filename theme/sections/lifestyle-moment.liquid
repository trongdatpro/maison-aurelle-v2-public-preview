{% comment %}
  Homepage Zone 4: Lifestyle / Brand Moment
{% endcomment %}

<section class="section-padding" style="background-color: var(--color-canvas);">
  <div class="container-boxed">
    <div style="display: grid; grid-template-columns: 1fr; gap: var(--gutter-desktop); align-items: center;" class="lifestyle-grid">
      <!-- Media Column -->
      <div class="lifestyle-media" style="width: 100%;">
        <div style="position: relative; width: 100%; aspect-ratio: 16 / 11; overflow: hidden; background-color: var(--color-surface-container); border: 1px solid var(--color-border); border-radius: var(--radius-base);">
          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 1400 }}"
              alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
              loading="lazy"
              width="1400"
              height="960"
              style="width: 100%; height: 100%; object-fit: cover;"
            >
          {%- else -%}
            <img
              src="/assets/preview/hero-living-room.jpg"
              alt="Parisian Haussmann salon with natural afternoon light and quiet furniture arrangement"
              loading="lazy"
              width="1400"
              height="960"
              style="width: 100%; height: 100%; object-fit: cover;"
            >
          {%- endif -%}
        </div>
      </div>

      <!-- Narrative Column -->
      <div class="lifestyle-narrative" style="display: flex; flex-direction: column; justify-content: center;">
        <span class="font-label-caps" style="color: var(--color-secondary); letter-spacing: 0.2em; margin-bottom: 0.5rem;">
          {{ section.settings.eyebrow | default: 'Harmonious Scale' }}
        </span>

        <h2 class="font-headline-lg" style="margin: 0 0 1.25rem 0; color: var(--color-primary); line-height: 1.2;">
          {{ section.settings.heading | default: 'Designed for Intimate Living Spaces' }}
        </h2>

        <p class="font-body-lg" style="color: var(--color-text-variant); margin: 0 0 2rem 0; font-weight: 300;">
          {{ section.settings.text | default: 'Every piece in our catalog is dimensionally calibrated to fit comfortably alongside classic and contemporary furniture without overpowering the room.' }}
        </p>

        <div>
          <a href="{{ section.settings.button_link | default: '#selection' }}" class="btn-primary">
            {{ section.settings.button_label | default: 'Shop the Look' }}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @media (min-width: 1024px) {
    .lifestyle-grid {
      grid-template-columns: 58% 42% !important;
    }
  }
</style>

{% schema %}
{
  "name": "Lifestyle Moment",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lifestyle Photograph"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Harmonious Scale"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed for Intimate Living Spaces"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Narrative Copy",
      "default": "Every piece in our catalog is dimensionally calibrated to fit comfortably alongside classic and contemporary furniture without overpowering the room."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop the Look"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Lifestyle Moment"
    }
  ]
}
{% endschema %}
