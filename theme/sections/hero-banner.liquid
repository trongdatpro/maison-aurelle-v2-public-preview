{% comment %}
  Homepage Zone 1: French Modern Classicism Hero Banner
{% endcomment %}

<section class="hero-banner-section" style="position: relative; width: 100%; min-height: 580px; height: 88vh; max-height: 900px; display: flex; align-items: center; justify-content: center; overflow: hidden; background-color: var(--color-primary);">
  <!-- Background Image with Overlay -->
  <div
    class="hero-banner-bg"
    style="position: absolute; inset: 0; width: 100%; height: 100%; background-size: cover; background-position: center; {% if section.settings.image != blank %}background-image: url('{{ section.settings.image | image_url: width: 2000 }}');{% else %}background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCLHWDcOSbPaTdpjr_G8kik5i52kfk4vXqNBaMUtWTgFmd_KV3ETy6yDEMapkZy1bq7kJIpvqJpYrcvhIuReUfeqS4N-K8GiJDZevZ_z02ygQYlFinr5vNi3_N1uUHv7YENzpnjPd5qRh7Wh7EPFv6Ky68-9WcHG-1T-HiSfh_MNA2rPxzXUwI1yauqX_RKlSsU9xls-OfHntkY5Qh6d_ei2TtkB5XDi_bXw0l_pnafTiPlAQLC9Z8uOQ');{% endif %}"
  ></div>

  <!-- Ambient Architectural Scrim -->
  <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(30, 27, 24, 0.82) 0%, rgba(30, 27, 24, 0.38) 50%, rgba(30, 27, 24, 0.22) 100%);"></div>

  <!-- Content Container -->
  <div class="container-boxed" style="position: relative; z-index: 10; text-align: center; display: flex; flex-direction: column; align-items: center;">
    <span class="font-label-caps" style="color: var(--color-surface-container); letter-spacing: 0.24em; margin-bottom: 0.75rem; opacity: 0.95;">
      {{ section.settings.subheading | default: 'French Modern Classicism' }}
    </span>

    <h1 class="font-display-hero" style="color: #ffffff; max-width: 840px; margin: 0; text-shadow: 0 1px 12px rgba(0,0,0,0.15);">
      {{ section.settings.heading | default: 'Curated Elegance, Measured Restraint' }}
    </h1>

    <p class="font-body-lg" style="color: rgba(245, 243, 239, 0.92); max-width: 640px; margin: 1.5rem 0 2.5rem 0; font-weight: 300;">
      {{ section.settings.text | default: 'Finely crafted accent tables, artisanal decorative objects, and architectural wall mouldings designed for Parisian-inspired modern spaces.' }}
    </p>

    <div class="hero-actions-group">
      {%- if section.settings.button_label_1 != blank -%}
        {%- assign default_link_1 = routes.all_products_collection_url -%}
        <a href="{{ section.settings.button_link_1 | default: default_link_1 }}" class="btn-white">
          {{ section.settings.button_label_1 }}
        </a>
      {%- endif -%}

      {%- if section.settings.button_label_2 != blank -%}
        {%- assign default_link_2 = routes.collections_url | append: '/side-and-accent-tables' -%}
        <a
          href="{{ section.settings.button_link_2 | default: default_link_2 }}"
          class="font-label-ui"
          style="color: #ffffff; text-transform: uppercase; letter-spacing: 0.12em; border-bottom: 1px solid rgba(255,255,255,0.6); padding-bottom: 2px;"
        >
          {{ section.settings.button_label_2 }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Eyebrow / Subheading",
      "default": "French Modern Classicism"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Curated Elegance, Measured Restraint"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Finely crafted accent tables, artisanal decorative objects, and architectural wall mouldings designed for Parisian-inspired modern spaces."
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary Button Label",
      "default": "Shop the Collection"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary Link Label",
      "default": "Explore Tables"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary Link Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
