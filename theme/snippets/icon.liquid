{% comment %}
  Renders SVG icons for Maison Aurelle V2
  Usage: {% render 'icon', name: 'search', class: 'custom-class' %}
{% endcomment %}

{% case name %}
  {% when 'search' %}
    <svg class="{{ class | default: 'w-5 h-5' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/>
    </svg>
  {% when 'account' %}
    <svg class="{{ class | default: 'w-5 h-5' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
    </svg>
  {% when 'cart' %}
    <svg class="{{ class | default: 'w-5 h-5' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25c-.67 0-1.19-.578-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/>
    </svg>
  {% when 'arrow-forward' %}
    <svg class="{{ class | default: 'w-4 h-4' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
    </svg>
  {% when 'menu' %}
    <svg class="{{ class | default: 'w-6 h-6' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="24" height="24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
    </svg>
  {% when 'close' %}
    <svg class="{{ class | default: 'w-5 h-5' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/>
    </svg>
  {% when 'check' %}
    <svg class="{{ class | default: 'w-4 h-4' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.5 12.75l6 6 9-13.5"/>
    </svg>
  {% when 'chevron-down' %}
    <svg class="{{ class | default: 'w-5 h-5' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
    </svg>
  {% when 'plus' %}
    <svg class="{{ class | default: 'w-4 h-4' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.5v15m7.5-7.5h-15"/>
    </svg>
  {% when 'minus' %}
    <svg class="{{ class | default: 'w-4 h-4' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 12h-15"/>
    </svg>
  {% when 'architecture' %}
    <svg class="{{ class | default: 'w-6 h-6' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="24" height="24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3L2 12h3v8h14v-8h3L12 3zm0 4.5a2.5 2.5 0 100 5 2.5 2.5 0 000-5zM8 20v-5h8v5H8z"/>
    </svg>
  {% when 'handyman' %}
    <svg class="{{ class | default: 'w-6 h-6' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="24" height="24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.223l2.87-2.87a2.548 2.548 0 10-3.604-3.604l-2.87 2.87m3.604 3.604L13.84 8.79"/>
    </svg>
  {% when 'shipping' %}
    <svg class="{{ class | default: 'w-6 h-6' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="24" height="24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H16.5m-6.75 0v4.5m0-4.5h6.75m-6.75 0H3.75a1.5 1.5 0 00-1.5 1.5v7.5"/>
    </svg>
  {% when 'shield' %}
    <svg class="{{ class | default: 'w-6 h-6' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="24" height="24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>
    </svg>
{% endcase %}
